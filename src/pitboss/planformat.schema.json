{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The Plan of a PR body, as pitboss format plan reads it",
  "type": "object", "required": ["rows"], "additionalProperties": false, "properties": {
    "intro": {"type": "string", "pattern": "^[^\\n]+$"},
    "rows": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["item"],
      "additionalProperties": false, "oneOf": [{"required": ["command"]}, {"required": ["ci"]}],
      "properties": {"item": {"type": "string", "pattern": "^[^\\n]+$"},
        "command": {"type": "string", "pattern": "^[^\\n`]+$"},
        "ci": {"type": "object", "required": ["workflow", "job", "step", "grep"], "additionalProperties": false,
          "properties": {"workflow": {"type": "string", "pattern": "^[^\\n`]+$"}, "job": {"type": "string", "pattern": "^[^\\n`]+$"},
            "step": {"type": "string", "pattern": "^[^\\n`]+$"}, "grep": {"type": "string", "pattern": "^[^\\n`]+$"}}}}}}}
}
